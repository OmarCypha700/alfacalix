# Copy this file to .env.local for local development, and add the same
# variables in Vercel → Project → Settings → Environment Variables.
# Anything left empty is hidden on the site (never shown as a broken link).

# ── Site ──────────────────────────────────────────────────────────────
# Full production URL, no trailing slash. Drives canonical URLs, the
# sitemap, robots.txt, Open Graph and structured data.
NEXT_PUBLIC_SITE_URL=

# ── Product landing pages (independently hosted) ─────────────────────
# Must start with https://. Empty = "site coming soon" state.
NEXT_PUBLIC_CLINOVA_URL=
NEXT_PUBLIC_SIS_URL=
NEXT_PUBLIC_DRS_URL=

# ── Public contact details (shown in footer, contact page, schema) ───
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=

# ── Social profiles (full URLs) ──────────────────────────────────────
NEXT_PUBLIC_SOCIAL_LINKEDIN=
NEXT_PUBLIC_SOCIAL_X=
NEXT_PUBLIC_SOCIAL_FACEBOOK=
NEXT_PUBLIC_SOCIAL_INSTAGRAM=
NEXT_PUBLIC_SOCIAL_GITHUB=

# ── Search engine verification (optional) ────────────────────────────
# Only the token value from the HTML-tag verification method.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# ── Contact form email delivery via Brevo (SERVER-ONLY, keep secret) ─
# Without these, the form tells visitors their message was NOT sent.
BREVO_API_KEY=
# Inbox that receives enquiries
CONTACT_TO_EMAIL=
# Sender address verified in Brevo (Senders, Domains & Dedicated IPs)
CONTACT_FROM_EMAIL=
CONTACT_FROM_NAME=Alfa Calix Technologies Website
